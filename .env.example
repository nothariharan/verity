# Verity — copy to .env and fill in locally. Do not commit .env.

# fake | real  (fake runs fully offline: STT, TTS, LLM)
PROVIDERS=fake

# ElevenLabs: STT (Scribe v2 Realtime) + TTS (Flash v2.5)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=
TTS_CLAUSE_STREAMING=false

# LLM: Gemini primary, OpenAI fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=luna
LLM_TIMEOUT_MS=8000
# Optional per-role overrides (else GEMINI_MODEL)
MODEL_EXTRACTOR=
MODEL_ASSESSOR=
MODEL_LIVE=
MODEL_DRAFTER=

# Server
DATABASE_URL=file:./data/verity.db
PORT=8787

# Web
NEXT_PUBLIC_SERVER_URL=http://localhost:8787
NEXT_PUBLIC_ENABLE_LENS=false
